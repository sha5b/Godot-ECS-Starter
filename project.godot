; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot ECS Starter"
config/description="Godot-native, inspector-first ECS starter kit: procedural chunked terrain, climate-driven biomes, weather, flora and fauna, plus a BotW-style actor runtime with a chemistry engine, utility AI, and tiered processing."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameConfig="*res://autoloads/game_config.gd"
SystemBus="*res://autoloads/system_bus.gd"
SharedWorld="*res://autoloads/shared_world.gd"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
